# ClearGate environment. Copy this file to .env for local work; on Vercel, set the same names under
# Project > Settings > Environment Variables. Never commit .env.

# --- Database (Neon Postgres) -------------------------------------------------------------------
# Neon console > your project > Dashboard > Connect. Pick your branch and database, then copy:
#   DATABASE_URL: the POOLED connection string (host contains "-pooler"). The app uses it at runtime.
#   DIRECT_URL:   the same string with "Connection pooling" switched off (no "-pooler"). Prisma uses it
#                 for `prisma migrate deploy` and the seed, which need a direct session.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- App ----------------------------------------------------------------------------------------
# Public base URL with no trailing slash. Password-reset emails link to APP_URL/reset-password.
# On Vercel use your production domain, e.g. https://cleargate.example.edu.ph
APP_URL="http://localhost:3000"

# Signs upload tickets and local upload URLs. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required on Vercel (when empty, CRON_SECRET is used instead). Changing it only cancels uploads in progress.
APP_SECRET=""

# Bearer token for GET /api/cron/tick (the minute scheduler). Another long random string.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>" when this variable is set.
# Leave empty locally if you don't need the cron route; the bell poll still runs the scheduler (see README).
CRON_SECRET=""

# 1 = the forgot-password reply includes the reset token, so the reset works without email.
# Local and demo use only. NEVER set 1 in production (it is ignored on a Vercel production deploy anyway).
DEMO_MODE="0"

# --- File storage (a private S3-compatible bucket) -----------------------------------------------
# Leave S3_BUCKET empty to store files on local disk in .data/uploads (development only; refused on Vercel).
# After filling these in, run `npm run storage:cors` once so browsers can upload (see README).
#
# Neon Object Storage (beta; same Neon project as the database, see README "File storage"):
#   Neon console > your branch > Object storage > New bucket (access level: private).
#   Connect > Storage shows the endpoint, region and credential (or `neon env pull`). Neon names them
#   AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY: copy the values into the
#   S3_* names here. The app does not read AWS_* names, and Vercel reserves them for its own runtime.
#   Use the endpoint of the SAME branch as DATABASE_URL; buckets belong to a branch.
#   S3_REGION is the region Neon shows (e.g. ap-southeast-1), not "auto".
# Cloudflare R2: dashboard > R2 > your bucket. Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
#   region "auto". Create keys under R2 > Manage R2 API Tokens ("Object Read & Write" on this bucket).
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION to the bucket's region, e.g. ap-southeast-1.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email (password resets via Resend) ---------------------------------------------------------
# resend.com > API Keys. Without a key, reset emails are not sent: the server logs that email is not
# configured (and, outside production, logs the reset link so you can open it yourself).
RESEND_API_KEY=""
# Sender shown in the email. The domain must be verified in Resend (Domains).
MAIL_FROM="ClearGate <no-reply@cgateway.edu.ph>"
